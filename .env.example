# UAV Sentinel — environment variables
# Copy to .env and fill in values. Never commit .env.

# OpenAI (Phase 4 AI Diagnostics) — used by FastAPI only
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: path to model artifacts (default: ./uav_model)
# UAV_MODEL_DIR=./uav_model

# Optional: flight store directory (default: ./data/flights)
# DATA_DIR=./data/flights

# Optional: CORS origins for the Next.js UI
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: max upload size hint (MB)
# UAV_MAX_UPLOAD_MB=100
