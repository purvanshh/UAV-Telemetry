# UAV Sentinel — environment variables
# Copy to .env and fill in values. Never commit .env.

# OpenAI (Phase 4 AI Diagnostics)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: path to model artifacts (default: ./uav_model)
# UAV_MODEL_DIR=./uav_model

# Optional: max upload size in MB (Streamlit also has its own limit)
# UAV_MAX_UPLOAD_MB=100
