{
  "version": "0.3.0",
  "timestamp": {
    "primary": "TimeUS",
    "unit_verified": "us",
    "inference": "rate-plausibility vote across all flights \u00d7 streams",
    "votes": {
      "us": 303,
      "ms": 0,
      "s": 0,
      "ns": 0
    },
    "conversion": "t_s = TimeUS / 1000000.0",
    "raw_nonmonotonic_flights": 0,
    "clock_reset_flights": 0
  },
  "streams": {
    "IMU": {
      "directory": "IMU/",
      "features": {
        "gyro_x": "GyrX",
        "gyro_y": "GyrY",
        "gyro_z": "GyrZ",
        "acc_x": "AccX",
        "acc_y": "AccY",
        "acc_z": "AccZ"
      },
      "units": {
        "gyro_x": "rad/s",
        "gyro_y": "rad/s",
        "gyro_z": "rad/s",
        "acc_x": "m/s^2",
        "acc_y": "m/s^2",
        "acc_z": "m/s^2"
      }
    },
    "ATT": {
      "directory": "ATT/",
      "features": {
        "roll": "Roll",
        "pitch": "Pitch",
        "yaw": "Yaw",
        "des_roll": "DesRoll",
        "des_pitch": "DesPitch",
        "des_yaw": "DesYaw"
      },
      "units": {
        "roll": "deg",
        "pitch": "deg",
        "yaw": "deg",
        "des_roll": "deg",
        "des_pitch": "deg",
        "des_yaw": "deg"
      }
    },
    "BARO": {
      "directory": "BARO/",
      "features": {
        "alt": "Alt",
        "alt_amsl": "AltAMSL",
        "press": "Press",
        "temp": "Temp"
      },
      "units": {
        "alt": "m",
        "alt_amsl": "m",
        "press": "Pa",
        "temp": "degC"
      }
    }
  },
  "derived_features": {
    "yaw_sin": {
      "formula": "sin(deg2rad(yaw))",
      "units": "unitless"
    },
    "yaw_cos": {
      "formula": "cos(deg2rad(yaw))",
      "units": "unitless"
    },
    "roll_res": {
      "formula": "roll - des_roll",
      "units": "deg"
    },
    "pitch_res": {
      "formula": "pitch - des_pitch",
      "units": "deg"
    },
    "alt_rate": {
      "formula": "d(alt)/dt (gap-guarded)",
      "units": "m/s"
    },
    "press_rate": {
      "formula": "d(press)/dt (gap-guarded)",
      "units": "Pa/s"
    }
  },
  "model_feature_order": [
    "gyro_x",
    "gyro_y",
    "gyro_z",
    "acc_x",
    "acc_y",
    "acc_z",
    "roll",
    "pitch",
    "yaw_sin",
    "yaw_cos",
    "roll_res",
    "pitch_res",
    "alt",
    "press",
    "temp",
    "alt_rate",
    "press_rate"
  ],
  "alignment": {
    "target_hz": 10.0,
    "max_gap_s": 0.5,
    "session_gap_s": 1.0,
    "session_source": "raw source timestamps (all three streams)"
  },
  "extreme_value_policy": {
    "default": "flag",
    "per_feature": {
      "press": {
        "min": 1000.0,
        "max": 120000.0,
        "action": "flag"
      },
      "alt": {
        "min": -1000.0,
        "max": 20000.0,
        "action": "flag"
      },
      "temp": {
        "min": -80.0,
        "max": 100.0,
        "action": "flag"
      }
    }
  },
  "window": {
    "win_samples": 30,
    "stride_samples": 15,
    "win_seconds": 3.0,
